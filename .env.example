# Prefer: bash scripts/dev.sh setup (creates .env and a random DB password).
# For an existing dataset mount, set NUSCENES_HOST_PATH to its absolute root.
POSTGRES_DB=drivescene
POSTGRES_USER=drivescene
POSTGRES_PASSWORD=replace-with-your-own-password
NUSCENES_HOST_PATH=./data/nuscenes
NUSCENES_VERSION=v1.0-mini
# true imports metadata on startup; repeated identical input is skipped.
NUSCENES_IMPORT_ENABLED=false
# Explicit origin stored with the metadata checksum: NUSCENES (official data), SYNTHETIC (test fixture) or UNKNOWN.
NUSCENES_DATA_ORIGIN=UNKNOWN
WEB_PORT=3000
APP_PORT=8080
AI_PORT=8000
# Host port of the Compose db (loopback). A second Compose project must change WEB_PORT, APP_PORT, AI_PORT and DB_PORT.
DB_PORT=55433
VESPA_TIMEOUT_SECONDS=7200
AUTO_LABEL_READ_TIMEOUT=7300s
AUTO_LABEL_WORKER_ENABLED=true
# Raise for slow CPU image inference when necessary.
AI_SERVER_READ_TIMEOUT=120s
# BLAS/OMP threads for VESPA subprocess only (does not affect CLIP).
VESPA_NUM_THREADS=1
# Rerun recording: exporter subprocess limit (s) and Spring wait; keep READ_TIMEOUT >= exporter limit.
# RECORDING_TIMEOUT_SECONDS=600
# RECORDING_READ_TIMEOUT=660s
# RECORDING_WORKER_ENABLED=true

# --- Optional: run VESPA on a remote Slurm cluster over SSH (see ai-server/VESPA_Seraph.md) ---
# Enable by uncommenting COMPOSE_FILE so plain `docker compose` also loads compose.seraph.yml.
# Put a dedicated key and known_hosts in ./secrets/vespa-ssh/ (git-ignored). Never commit real values.
#COMPOSE_FILE=compose.yml:compose.seraph.yml
#VESPA_SSH_TARGET=<user>@<login-host>
#VESPA_SSH_PORT=22
#VESPA_SSH_REMOTE_ROOT=/absolute/path/to/VESPA
#VESPA_SSH_EXP=p_final
#VESPA_SSH_SBATCH_SCRIPT=pseudo_scenes_lowmem.sh
#VESPA_SSH_POLL_SECONDS=30
